parameters:
  level: 6
  paths:
    - src

  tmpDir: .phpstan-cache

  # WordPress core functions (__, _e, esc_html__, wp_*, get_option, …) are
  # resolved by szepeviktor/phpstan-wordpress + php-stubs/wordpress-stubs, so no
  # blanket "unknown function" ignores are needed here.

  # Reflection shims loaded by PHPStan only:
  #  - WordPress globals/functions ($wpdb, __(), wp_*, …) via szepeviktor.
  #  - Plugin constants from the runtime entry files (SIRUS_*, SPX_ENV_CHECK_*),
  #    otherwise reported as constant.notFound.
  #  - Signatures for OPTIONAL deps not installed in CI (matomo/device-detector
  #    suggest, Action Scheduler functions), so they don't trip class/function
  #    .notFound. None of these are autoloaded or executed at runtime.
  bootstrapFiles:
    - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
    - phpstan-bootstrap.php
    - phpstan/stubs/optional-dependencies.php

  # Optional: stricter type inference, can enable later
  checkMissingTypehints: false

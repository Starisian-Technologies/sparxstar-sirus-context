{
  "name": "sparxstar-user-environment-check",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "description": "WordPress plugin for browser, device, and environment diagnostics using a modern ES Module architecture.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Starisian Technologies",
  "scripts": {
    "lint:js": "eslint src/js/",
    "lint:css": "stylelint src/css/",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:fix": "eslint src/js/ --fix",
    "format": "prettier --write \"src/**/*.{js,css}\"",
    "fix": "pnpm run lint:fix && pnpm run stylelint:fix && pnpm run format",
    "stylelint:fix": "stylelint \"src/css/**/*.css\" --fix",
    "clean": "rm -f assets/css/sparxstar-user-environment-check.min.css assets/js/sirus-context.js",
    "validate": "node validate-build.cjs",
    "build:css": "postcss src/css/sparxstar-user-environment-check.css -o assets/css/sparxstar-user-environment-check.min.css",
    "build:js": "rollup -c roll-up.config.mjs",
    "build:js:dev": "rollup -c roll-up.config.dev.mjs",
    "build": "pnpm run validate && pnpm run clean && mkdir -p assets/js assets/css && pnpm run build:css && pnpm run build:js && pnpm run verify:assets",
    "build:dev": "pnpm run validate && pnpm run clean && mkdir -p assets/js assets/css && pnpm run build:css && pnpm run build:js:dev && pnpm run verify:assets",
    "version:sync": "node sync-version.js",
    "verify:assets": "node verify-assets.cjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "cssnano": "^9.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  },
  "packageManager": "pnpm@8.6.0",
  "pnpm": {
    "overrides": {
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "semver": ">=7.5.2",
      "glob": ">=11.1.0",
      "tmp": ">=0.2.4",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "ajv@<6.14.0": ">=6.14.0",
      "@humanfs/node@<0.16.8": ">=0.16.8 <0.17.0",
      "brace-expansion@<1.1.21": ">=1.1.21 <2.0.0",
      "fast-uri@<3.1.8": ">=3.1.8 <4.0.0",
      "js-yaml@<4.3.2": ">=4.3.2 <5.0.0",
      "postcss-selector-parser@<7.1.6": ">=7.1.6 <8.0.0"
    }
  }
}
